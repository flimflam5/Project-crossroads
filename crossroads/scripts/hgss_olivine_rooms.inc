@ Ambient Olivine interiors. No grants, trades, story flags or badge changes.
Hgss_OlivineFishingResident::
    msgbox Hgss_OlivineFishingResident_Text, MSGBOX_NPC
    end
Hgss_OlivineFishingResident_Text:
    .string "The harbor is a good place to watch\nthe tide before a fishing trip.\pI always check my line before\nI leave the house.$"
Hgss_OlivineTradeResident::
    msgbox Hgss_OlivineTradeResident_Text, MSGBOX_NPC
    end
Hgss_OlivineTradeResident_Text:
    .string "A Pokemon can arrive from far away\nand still make itself at home.\pI suppose people can do that, too.$"
Hgss_OlivineSealResident::
    msgbox Hgss_OlivineSealResident_Text, MSGBOX_NPC
    end
Hgss_OlivineSealResident_Text:
    .string "We keep our little collections on\nthe shelves, out of the sea air.\pSalt gets into everything here!$"
Hgss_OlivineHouseChild::
    msgbox Hgss_OlivineHouseChild_Text, MSGBOX_NPC
    end
Hgss_OlivineHouseChild_Text:
    .string "From the lighthouse, the ships\nlook small enough to hold!$"
Hgss_OlivineCafeHost::
    msgbox Hgss_OlivineCafeHost_Text, MSGBOX_NPC
    end
Hgss_OlivineCafeHost_Text:
    .string "Welcome to OLIVINE CAFE.\nMind the plates by the counter!$"
Hgss_OlivineCafeSailor::
    msgbox Hgss_OlivineCafeSailor_Text, MSGBOX_NPC
    end
Hgss_OlivineCafeSailor_Text:
    .string "A hot meal and a chair that\ndoesn't move with the waves.\pThat's a proper shore break.$"
Hgss_OlivineCafeVisitor::
    msgbox Hgss_OlivineCafeVisitor_Text, MSGBOX_NPC
    end
Hgss_OlivineCafeVisitor_Text:
    .string "There's time for one quiet cup\nbefore the next shift.$"
